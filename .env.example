# CampusMart Environment Variables
PORT=3000
NODE_ENV=development

# Database (Priority 1: Supabase PostgreSQL, Priority 2: MongoDB, Priority 3: Local SQLite Persistent DB)
# Get these from Supabase Dashboard -> Project Settings -> API
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Connect to your local or MongoDB Atlas instance.
# If neither Supabase nor MongoDB is configured/running, CampusMart persists automatically in ./data/campusmart.db!
MONGODB_URI=mongodb://localhost:27017/campusmart
SQLITE_DB_PATH=./data/campusmart.db

# JWT Secret for authentication
JWT_SECRET=campusmart_super_secure_jwt_token_secret_key_2026_dev

# NextAuth / App URL
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Store Default Timezone
DEFAULT_TIMEZONE=Asia/Kolkata

# Optional: Real Gmail SMTP Integration
# To deliver OTP emails directly into your real Gmail inbox, generate a 16-character
# Google App Password from https://myaccount.google.com/apppasswords and fill below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_character_app_password

# =========================
# Feature 1: AI Shopping Assistant (Provider-Agnostic LLM)
# =========================
# Supports OpenAI-compatible endpoints (OpenAI, Groq, OpenRouter, Together) or Google Gemini.
# Leave LLM_API_KEY blank to automatically use the built-in catalog search fallback.
# LLM_PROVIDER=auto
# LLM_API_KEY=your_llm_api_key
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# =========================
# Feature 2: Price Drop Alerts, Email & Cron
# =========================
# Optional Resend API key (used before SMTP/Nodemailer fallback if configured)
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# EMAIL_FROM="CampusMart Alerts <alerts@campusmart.edu>"

# Shared secret for scheduled GET/POST /api/cron/price-check safety job
CRON_SECRET=campusmart_cron_secret_2026_dev

# Optional future external alert channels
# PUSH_WEBHOOK_URL=
# WHATSAPP_WEBHOOK_URL=


